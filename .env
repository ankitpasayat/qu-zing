# Qu-Zing Environment Configuration Template
# Copy this file to .env.local and fill in your real values
# .env.local is gitignored and will never be committed

# Discord Application Configuration
# Get these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_PUBLIC_KEY=your_public_key_from_discord
DISCORD_BOT_TOKEN=your_bot_token_here

# Gen AI Service Configuration
# Get your free API key: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1 million tokens/day
GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenAI API key for alternative question generation
# OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
APP_URL=https://your-domain.com

# Analytics Dashboard Authentication
ANALYTICS_USERNAME=admin
ANALYTICS_PASSWORD=change_this_secure_password

# Docker Compose Scaling (optional)
SERVER_INSTANCES=3
