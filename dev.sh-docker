#!/bin/bash
set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Debug mode (inherited from dev.sh)
DEBUG=${DEBUG:-false}

# Helper for conditional output
log() {
    if [ "$DEBUG" = true ]; then
        echo -e "$@"
    fi
}

# Check .env.local (real secrets)
if [ ! -f .env.local ]; then
    echo -e "${RED}✗ .env.local file not found${NC}"
    echo -e "${YELLOW}Copy .env template and configure it:${NC}"
    echo "  cp .env .env.local"
    echo "  nano .env.local"
    exit 1
fi

# Export from .env.local
set -a
source .env.local
set +a
SERVER_INSTANCES=${SERVER_INSTANCES:-3}

log "${GREEN}✓ Dependencies OK${NC}"
log "${BLUE}Starting ${SERVER_INSTANCES} server instances with load balancing...${NC}"
log ""

# Cleanup
cleanup() {
    echo -e "\n${YELLOW}Shutting down...${NC}"
    docker-compose down
    echo -e "${GREEN}✅ Stopped${NC}"
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

# Stop existing
docker-compose down 2>/dev/null || true

# Build and start
log "${BLUE}Building images...${NC}"
if [ "$DEBUG" = true ]; then
    docker-compose build
else
    docker-compose build -q
fi

log "${BLUE}Starting services...${NC}"
docker-compose up -d --scale server=${SERVER_INSTANCES} > /dev/null 2>&1

# Wait for health
log "${YELLOW}Waiting for health check...${NC}"
for i in {1..30}; do
    if curl -sf http://localhost:3000/api/health >/dev/null 2>&1; then
        log "${GREEN}✓ Services healthy${NC}"
        break
    fi
    sleep 1
    [ "$DEBUG" = true ] && echo -n "."
done
log ""

# Get tunnel URL from docker logs
log "${YELLOW}Getting tunnel URL...${NC}"
TUNNEL_URL=""
for i in {1..30}; do
    TUNNEL_URL=$(docker-compose logs tunnel 2>/dev/null | grep -oP 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' | tail -1)
    [ -n "$TUNNEL_URL" ] && break
    sleep 1
done

# Always show the tunnel URL prominently
echo ""
echo -e "${GREEN}══════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}  🚀 DOCKER COMPOSE READY${NC}"
echo -e "${GREEN}  🌐 TUNNEL URL: ${YELLOW}${TUNNEL_URL}${NC}"
echo -e "${GREEN}══════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$DEBUG" = true ]; then
    # Display full info in debug mode
    echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║              🚀 DOCKER COMPOSE - READY 🚀                  ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BLUE}🌐 Public URL:${NC}        ${YELLOW}${TUNNEL_URL}${NC}"
    echo -e "${BLUE}📊 Analytics:${NC}         ${YELLOW}${TUNNEL_URL}/analytics${NC}"
    echo -e "${BLUE}🏠 Local (LB):${NC}        ${YELLOW}http://localhost:8080${NC}"
    echo -e "${BLUE}🏥 Health:${NC}            ${YELLOW}http://localhost:3000/api/health${NC}"
    echo ""
    echo -e "${BLUE}🔧 Architecture:${NC}"
    echo -e "   • ${SERVER_INSTANCES} Node.js servers (worker threads)"
    echo -e "   • Redis (Socket.IO sync)"
    echo -e "   • Nginx (load balancer + sticky sessions)"
    echo -e "   • Cloudflare tunnel (public access)"
    echo ""
    echo -e "${BLUE}📝 Useful Commands:${NC}"
    echo -e "   ${YELLOW}docker-compose logs -f${NC}           # All logs"
    echo -e "   ${YELLOW}docker-compose logs -f server${NC}    # Server logs"
    echo -e "   ${YELLOW}docker-compose logs -f tunnel${NC}    # Tunnel logs"
    echo -e "   ${YELLOW}docker stats${NC}                      # Resource usage"
    echo ""
    echo -e "${BLUE}🎮 Discord Setup:${NC}"
    echo -e "   1. Go to https://discord.com/developers/applications"
    echo -e "   2. OAuth2 Redirect: ${YELLOW}${TUNNEL_URL}/${NC}"
    echo -e "   3. Activity URL: ${YELLOW}/${NC} → ${YELLOW}${TUNNEL_URL}${NC}"
    echo -e "   4. Wait 5-10 minutes for propagation"
    echo ""
    echo -e "${GREEN}Press Ctrl+C to stop everything${NC}"
    echo ""
    echo -e "${BLUE}════════════════════════════════════════════════════════════${NC}"
    echo ""

    # Show live logs in debug mode
    docker-compose logs -f
else
    # Silent mode - just wait
    wait
fi
